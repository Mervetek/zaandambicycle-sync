          "settings": {
            "show_read_more": true
          }
        },
        "custom_liquid_KULMdX": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  ACCU + LADER seçici (BİRLEŞİK blok). Eski ayrı 'battery-selector' bloğunun YERİNE ekle\n  (iki ayrı blok add-to-cart'ı çakıştırır — bu tek blok ikisini birlikte yönetir).\n  - Accu = ek-ücret varyantı (data/surcharge-map.json)\n  - Lader = gerçek şarj ürünü varyantı (specs.charger_options metafield)\n  Add-to-cart devralınır: bisiklet + (seçili accu toeslag) + (seçili lader) birlikte eklenir.\n  Xtra ürün sayfasına Custom Liquid bloğu olarak yapıştır.\n{%- endcomment -%}\n{%- assign batts = product.metafields.specs.battery_options.value -%}\n{%- assign chargers = product.metafields.specs.charger_options.value -%}\n{%- if batts.size > 0 or chargers.size > 0 -%}\n  <div class=\"bc-selector\" data-base=\"{{ product.price }}\" style=\"margin:16px 0;\">\n\n    {%- if batts.size > 0 -%}\n      <label style=\"display:block;font-weight:600;margin-bottom:8px;\">Accu</label>\n      <div style=\"display:flex;flex-direction:column;gap:8px;\">\n        {%- for b in batts -%}\n          {%- if b.additional_cost and b.additional_cost > 0 -%}\n            {%- capture lbl -%}{{ b.capacity_wh }}Wh (+ {{ b.additional_cost | times: 100 | money }}){%- endcapture -%}\n          {%- else -%}\n            {%- capture lbl -%}{{ b.capacity_wh }}Wh (inbegrepen){%- endcapture -%}\n          {%- endif -%}\n          <label style=\"display:flex;align-items:center;gap:10px;border:1px solid #ccc;border-radius:6px;padding:10px 14px;cursor:pointer;\">\n            <input type=\"radio\" name=\"battery-opt\" value=\"{{ b.additional_cost | default: 0 }}\" data-cap=\"{{ b.capacity_wh }}Wh\" data-label=\"{{ lbl | escape }}\" {% if forloop.first %}checked{% endif %}>\n            <span style=\"font-weight:600;\">{{ b.capacity_wh }}Wh</span>\n            <span style=\"margin-left:auto;color:#0a7d28;font-weight:600;\">\n              {%- if b.additional_cost and b.additional_cost > 0 -%}+ {{ b.additional_cost | times: 100 | money }}{%- else -%}Inbegrepen{%- endif -%}\n            </span>\n          </label>\n        {%- endfor -%}\n      </div>\n    {%- endif -%}\n\n    {%- if chargers.size > 0 -%}\n      <label style=\"display:block;font-weight:600;margin:16px 0 8px;\">Lader</label>\n      <div style=\"display:flex;flex-direction:column;gap:8px;\">\n        <label style=\"display:flex;align-items:center;gap:10px;border:1px solid #ccc;border-radius:6px;padding:10px 14px;cursor:pointer;\">\n          <input type=\"radio\" name=\"charger-opt\" value=\"\" data-price=\"0\" checked>\n          <span>Geen extra lader</span>\n        </label>\n        {%- for c in chargers -%}\n          <label style=\"display:flex;align-items:center;gap:10px;border:1px solid #ccc;border-radius:6px;padding:10px 14px;cursor:pointer;\">\n            <input type=\"radio\" name=\"charger-opt\" value=\"{{ c.variant_id }}\" data-price=\"{{ c.price }}\">\n            <span style=\"font-weight:600;\">{{ c.name }}</span>\n            <span style=\"margin-left:auto;color:#0a7d28;font-weight:600;\">+ {{ c.price | times: 100 | money }}</span>\n          </label>\n        {%- endfor -%}\n      </div>\n    {%- endif -%}\n\n    <div style=\"margin-top:12px;font-size:1.1em;font-weight:700;\">\n      Totaal: <span class=\"bc-total\">{{ product.price | money }}</span>\n    </div>\n  </div>\n  <script>\n  (function(){\n    var box = document.querySelector('.bc-selector');\n    if(!box) return;\n    var SUR = {\"100\":\"58361774735747\",\"150\":\"58361774768515\",\"200\":\"58361774801283\",\"300\":\"58361774834051\",\"400\":\"58361774866819\",\"449\":\"58361774899587\",\"549\":\"58361774932355\",\"649\":\"58361774965123\",\"749\":\"58361774997891\",\"759\":\"58361775030659\",\"949\":\"58361775063427\",\"959\":\"58361775096195\"};\n    var base = parseInt(box.getAttribute('data-base'),10) || 0;\n    var totalEl = box.querySelector('.bc-total');\n    function fmt(c){ return '€ ' + (c/100).toLocaleString('nl-NL',{minimumFractionDigits:2,maximumFractionDigits:2}); }\n    function bsel(){ return box.querySelector('input[name=\"battery-opt\"]:checked'); }\n    function csel(){ return box.querySelector('input[name=\"charger-opt\"]:checked'); }\n    function calc(){\n      var bc = bsel() ? (parseInt(bsel().value,10)||0) : 0;\n      var cc = csel() ? (parseFloat(csel().getAttribute('data-price'))||0) : 0;\n      totalEl.textContent = fmt(base + bc*100 + Math.round(cc*100));\n    }\n    box.querySelectorAll('input[name=\"battery-opt\"],input[name=\"charger-opt\"]').forEach(function(r){ r.addEventListener('change', calc); });\n    calc();\n\n    var busy = false;\n    function addToCart(form){\n      if(busy) return; busy = true;\n      var idInput = form.querySelector('[name=\"id\"]');\n      var qty = parseInt((form.querySelector('[name=\"quantity\"]')||{}).value,10) || 1;\n      var items = [];\n      var br = bsel(); var bcost = br ? (parseInt(br.value,10)||0) : 0;\n      items.push({ id: parseInt(idInput.value,10), quantity: qty, properties: br ? {\"Accu\": br.getAttribute('data-label')} : {} });\n      if(bcost > 0 && SUR[String(bcost)]){\n        items.push({ id: parseInt(SUR[String(bcost)],10), quantity: qty, properties: {\"Accu\": br.getAttribute('data-cap'), \"_voor\": {{ product.title | json }} } });\n      }\n      var cr = csel();\n      if(cr && cr.value){\n        items.push({ id: parseInt(cr.value,10), quantity: qty, properties: {\"Lader voor\": {{ product.title | json }} } });\n      }\n      fetch('/cart/add.js', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({items:items}) })\n        .then(function(res){ if(!res.ok) throw 0; window.location = '/cart'; })\n        .catch(function(){ busy=false; form.submit(); });\n    }\n    document.addEventListener('click', function(ev){\n      var btn = ev.target.closest('[name=\"add\"]');\n      if(!btn) return;\n      var form = btn.closest('form');\n      if(!form || !form.querySelector('[name=\"id\"]')) return;\n      ev.preventDefault(); ev.stopImmediatePropagation();\n      addToCart(form);\n    }, true);\n  })();\n  </script>\n{%- endif -%}"
          }
        },
